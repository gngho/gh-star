# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# ── 필수 ────────────────────────────────────────────────────────────
# GitHub REST/GraphQL 조회용
# 로컬: PAT (classic 은 public_repo, fine-grained 는 Public repositories 읽기)
# Actions: 기본 제공 GITHUB_TOKEN 을 쓰므로 시크릿 등록 불필요
GITHUB_TOKEN=


# ── 비워두세요 (의도적으로) ──────────────────────────────────────────
# research/compose 는 로컬에서 Claude Code 구독 로그인으로 돕니다 (SPEC 9.0).
#
# ⚠️ 이 값을 채우면 구독 대신 API 과금으로 전환됩니다. 조용히 바뀌므로 주의.
#    비워두는 것이 정상 상태이고, 경고가 아닙니다.
#
# 채워야 하는 경우는 하나뿐입니다: research/compose 까지 CI 에서 무인 실행하고
# 싶을 때. 그때는 이 값을 저장소 시크릿에 넣으면 코드 변경 없이 동작합니다.
# ANTHROPIC_API_KEY=


# ── M5 발행 단계에서 필요 ────────────────────────────────────────────
# 발급 절차는 아래 "인스타그램 토큰 받는 법" 참고.
IG_USER_ID=
IG_ACCESS_TOKEN=


# ────────────────────────────────────────────────────────────────────
# 인스타그램 토큰 받는 법
# ────────────────────────────────────────────────────────────────────
#
# 0. 사전 조건
#    인스타그램 계정을 프로페셔널(비즈니스 또는 크리에이터)로 전환해둡니다.
#    개인 계정으로는 API 발행이 불가능합니다.
#
# 1. Meta 개발자 대시보드에서 앱 생성
#    developers.facebook.com/apps → 앱 만들기 → 유형 **비즈니스** 선택
#    (다른 유형이면 API 설정 화면이 나오지 않아 새로 만들어야 합니다)
#
# 2. Instagram 제품 추가
#    좌측 메뉴 → 제품 추가 → Instagram
#
# 3. 토큰 생성  ← OAuth 를 직접 구현할 필요 없습니다
#    Instagram → "API setup with Instagram business login"
#    → 계정 옆 [Generate token] → 인스타그램 로그인/승인 → 토큰 복사
#
#    이 경로로 받은 토큰은 처음부터 **60일짜리 장기 토큰**입니다.
#    (Business Login 흐름을 직접 구현하면 1시간짜리가 나와 교환 단계가 더 필요합니다)
#
#    필요 권한: instagram_business_basic, instagram_business_content_publish
#    본인 소유 계정만 다루므로 Standard Access 로 충분합니다.
#
# 4. IG_USER_ID 조회
#    curl "https://graph.instagram.com/v25.0/me?fields=user_id,username&access_token=<토큰>"
#    응답의 user_id 를 IG_USER_ID 에 넣습니다.
#
# 5. ⚠️ 60일마다 갱신해야 합니다 — 놓치면 영구 만료
#    GET https://graph.instagram.com/refresh_access_token
#        ?grant_type=ig_refresh_token&access_token=<현재 토큰>
#
#    조건: 발급 후 24시간 이상 지났고, 아직 만료되지 않았을 것.
#    **60일 동안 한 번도 갱신하지 않으면 토큰이 죽고 되살릴 수 없습니다.**
#    3번부터 다시 해야 하므로, 갱신은 사람이 기억하지 말고 워크플로 C 가
#    월 1회 자동으로 돌리게 합니다 (SPEC 9.4).


# ── 워크플로 C(토큰 자동 갱신)용 ─────────────────────────────────────
# 갱신한 토큰을 저장소 시크릿에 다시 써야 하므로 쓰기 권한 PAT 이 필요합니다.
# 로컬에는 필요 없고 저장소 시크릿에만 넣습니다.
# SECRETS_ADMIN_PAT=
