# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# M1 필수 — GitHub REST/GraphQL 조회용
# 로컬 개발: PAT (classic 은 public_repo, fine-grained 는 Public repositories 읽기 권한)
# GitHub Actions: 기본 제공 GITHUB_TOKEN 사용
GITHUB_TOKEN=

# M2 부터 필요 — Claude Agent SDK
ANTHROPIC_API_KEY=

# M5 부터 필요 — 인스타그램 발행
IG_USER_ID=
IG_ACCESS_TOKEN=
