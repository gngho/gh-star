{#
  카드 1장 = 1080×1350 (4:5). SPEC 7.3.

  scale 은 오버플로 자동 축소용이다. 1.0 으로 렌더해 넘치면 0.92, 0.85 로 다시 그린다.
  텍스트를 잘라내지 않고 크기를 줄이는 이유는 문장이 끊긴 채 발행되는 걸 막기 위해서다.
#}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<style>
@font-face {
  font-family: "Pretendard Variable";
  src: url("{{ font_uri }}") format("woff2-variations");
  font-weight: 100 900;
  font-display: block;
}

{{ tokens_css }}

* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
  width: {{ width }}px;
  height: {{ height }}px;
  overflow: hidden;
}

body {
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "tnum";
  word-break: keep-all;       /* 한글은 어절 단위로 끊는다 */
  overflow-wrap: break-word;
}

.card {
  position: relative;
  width: 100%;
  height: 100%;
  padding: var(--pad-y) var(--pad-x);
  display: flex;
  flex-direction: column;
  font-size: {{ scale }};      /* 축소 배율의 기준 */
}

/* 상단 좌측 은은한 광원 — 밋밋한 단색 배경을 피한다 */
.card::before {
  content: "";
  position: absolute;
  top: -280px; left: -200px;
  width: 760px; height: 760px;
  background: radial-gradient(circle, rgba(124, 92, 255, .22), transparent 68%);
  pointer-events: none;
}

/* eyebrow 는 content 안에 둔다. 최상단에 고정하면 본문과 멀어져
   고아처럼 뜨고, 카드 위쪽에 죽은 공간이 생긴다. */
.eyebrow {
  font-size: calc(var(--size-eyebrow) * {{ scale }});
  font-weight: 700;
  letter-spacing: .06em;
  color: var(--accent-soft);
  margin-bottom: calc(-12px * {{ scale }});  /* 제목과 한 덩어리로 붙인다 */
}

.content {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: calc(var(--gap) * {{ scale }});
  min-height: 0;
}

.title {
  font-size: calc({{ 'var(--size-title-cover)' if card.role == 'cover' else 'var(--size-title)' }} * {{ scale }});
  font-weight: 800;
  line-height: var(--leading-title);
  letter-spacing: -.02em;
}

.body {
  font-size: calc(var(--size-body) * {{ scale }});
  font-weight: 400;
  line-height: var(--leading-body);
  color: var(--fg-muted);
}

.code {
  background: var(--bg-code);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: calc(30px * {{ scale }});
  font-family: var(--font-mono);
  font-size: calc(var(--size-code) * {{ scale }});
  line-height: 1.7;
  color: var(--accent-2);
  white-space: pre;
  overflow: hidden;
}
.code .line::before { content: "$ "; color: var(--fg-faint); }

.footnote {
  font-size: calc(var(--size-meta) * {{ scale }});
  color: var(--fg-muted);   /* faint 는 본문 옆에서 거의 안 보인다 */
  line-height: 1.5;
  padding-left: calc(20px * {{ scale }});
  border-left: 3px solid var(--border);
}

/* 커버 전용 — 스타 증가량 배지 */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  align-self: flex-start;
  background: rgba(124, 92, 255, .14);
  border: 1px solid rgba(124, 92, 255, .38);
  border-radius: 999px;
  padding: calc(14px * {{ scale }}) calc(28px * {{ scale }});
  font-size: calc(var(--size-meta) * {{ scale }});
  font-weight: 600;
  color: var(--accent-soft);
}

/* 하단 바 */
.footer {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  font-size: calc(var(--size-meta) * {{ scale }});
  color: var(--fg-faint);
  padding-top: calc(var(--gap) * {{ scale }});
}
.repo-tag { font-family: var(--font-mono); color: var(--fg-muted); }

.pager { display: flex; gap: 8px; align-items: center; }
.dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--fg-faint); opacity: .35;
}
.dot.on { background: var(--accent); opacity: 1; width: 22px; border-radius: 999px; }
</style>
</head>
<body>
<div class="card">
  <div class="content" id="measure">
    {% if eyebrow %}<div class="eyebrow">{{ eyebrow }}</div>{% endif %}
    <h1 class="title">{{ card.title }}</h1>

    {% if card.role == 'cover' and star_badge %}
      <div class="badge">⭐ {{ star_badge }}</div>
    {% endif %}

    {% if card.body %}<p class="body">{{ card.body }}</p>{% endif %}

    {% if card.code %}
      <div class="code">{% for line in card.code %}<div class="line">{{ line }}</div>{% endfor %}</div>
    {% endif %}

    {% if card.footnote %}<div class="footnote">{{ card.footnote }}</div>{% endif %}
  </div>

  <div class="footer">
    {# 커버는 제목이 곧 레포명이라 하단 태그가 중복된다 #}
    <span class="repo-tag">{{ '' if card.role == 'cover' else repo }}</span>
    <span class="pager">
      {% for i in range(total) %}<span class="dot{{ ' on' if i + 1 == card.index else '' }}"></span>{% endfor %}
    </span>
  </div>
</div>
</body>
</html>
