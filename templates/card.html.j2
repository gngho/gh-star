{#
  카드 1장 = 1080×1350 (4:5). SPEC 7.3.

  scale 은 오버플로 자동 축소용이다. 1.0 으로 렌더해 넘치면 0.92, 0.85 로 다시 그린다.
  텍스트를 잘라내지 않고 크기를 줄이는 이유는 문장이 끊긴 채 발행되는 걸 막기 위해서다.
#}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<style>
@font-face {
  font-family: "Pretendard Variable";
  src: url("{{ font_uri }}") format("woff2-variations");
  font-weight: 100 900;
  font-display: block;
}

{{ tokens_css }}

* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
  width: {{ width }}px;
  height: {{ height }}px;
  overflow: hidden;
}

body {
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "tnum";
  word-break: keep-all;       /* 한글은 어절 단위로 끊는다 */
  overflow-wrap: break-word;
}

.card {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  font-size: {{ scale }};      /* 축소 배율의 기준 */
}

/* 상단 이미지 영역 — 이미지가 있을 때만 그린다.
   자리표시자를 그대로 내보내면 "여기에 이미지가 삽입됩니다"가 발행되므로,
   이미지가 없으면 이 영역을 아예 만들지 않고 본문이 카드 전체를 쓴다. */
.image-slot {
  position: relative;
  width: 100%;
  height: calc(470px * {{ scale }});
  flex: none;
  background-color: var(--bg-elevated);
  background-image: url("{{ card.image }}");
  background-size: cover;
  background-position: center;
}
/* 이미지 아래를 배경색으로 녹여 본문과 이어지게 한다 */
.image-slot::after {
  content: "";
  position: absolute;
  inset: auto 0 0 0;
  height: calc(160px * {{ scale }});
  background: linear-gradient(to bottom, transparent, var(--bg));
}

.body-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: calc(var(--pad-y) * {{ '0.75' if card.image else '1' }}) var(--pad-x) var(--pad-y);
}

/* 상단 좌측 은은한 광원 — 밋밋한 단색 배경을 피한다 */
.card::before {
  content: "";
  position: absolute;
  top: -280px; left: -200px;
  width: 760px; height: 760px;
  /* accent 토큰에서 파생시킨다. 하드코딩하면 design-sync 로 색을 바꿔도
     이 광원만 옛 색으로 남는다 — 실제로 그렇게 어긋났었다. */
  background: radial-gradient(
    circle,
    color-mix(in srgb, var(--accent) 22%, transparent),
    transparent 68%
  );
  pointer-events: none;
}

/* eyebrow 는 content 안에 둔다. 최상단에 고정하면 본문과 멀어져
   고아처럼 뜨고, 카드 위쪽에 죽은 공간이 생긴다. */
.eyebrow {
  font-size: calc(var(--size-eyebrow) * {{ scale }});
  font-weight: 700;
  letter-spacing: .06em;
  color: var(--accent-soft);
  margin-bottom: calc(-12px * {{ scale }});  /* 제목과 한 덩어리로 붙인다 */
}

.content {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: calc(var(--gap) * {{ scale }});
  min-height: 0;
}

.title {
  font-size: calc({{ 'var(--size-title-cover)' if card.role == 'cover' else 'var(--size-title)' }} * {{ scale }});
  font-weight: 800;
  line-height: var(--leading-title);
  letter-spacing: -.02em;
}

.body {
  font-size: calc(var(--size-body) * {{ scale }});
  font-weight: 400;
  line-height: var(--leading-body);
  color: var(--fg-muted);
}
/* 문장마다 블록. 한 줄에 두 문장이 걸치면 뒤 문장이 줄 끝에서 시작해
   어정쩡하게 잘린다. 블록을 주면 다음 문장은 항상 새 줄에서 시작한다. */
.body .s { display: block; }
.body .s + .s { margin-top: calc(6px * {{ scale }}); }

.code {
  background: var(--bg-code);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: calc(30px * {{ scale }});
  font-family: var(--font-mono);
  font-size: calc(var(--size-code) * {{ scale }});
  line-height: 1.7;
  color: var(--accent-2);
  white-space: pre;
  overflow: hidden;
}
.code .line::before { content: "$ "; color: var(--fg-faint); }

.footnote {
  font-size: calc(var(--size-meta) * {{ scale }});
  color: var(--fg-muted);   /* faint 는 본문 옆에서 거의 안 보인다 */
  line-height: 1.5;
  padding-left: calc(20px * {{ scale }});
  border-left: 3px solid var(--border);
}

/* 커버 전용 — 스타 증가량 배지 */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  align-self: flex-start;
  background: color-mix(in srgb, var(--accent) 14%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
  border-radius: 999px;
  padding: calc(14px * {{ scale }}) calc(28px * {{ scale }});
  font-size: calc(var(--size-meta) * {{ scale }});
  font-weight: 600;
  color: var(--accent-soft);
}

/* 하단 바 */
.footer {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  font-size: calc(var(--size-meta) * {{ scale }});
  color: var(--fg-faint);
  padding-top: calc(var(--gap) * {{ scale }});
}
.repo-tag { font-family: var(--font-mono); color: var(--fg-muted); }
</style>
</head>
<body>
<div class="card">
  {% if card.image %}<div class="image-slot"></div>{% endif %}

  <div class="body-wrap">
    <div class="content" id="measure">
      {% if eyebrow %}<div class="eyebrow">{{ eyebrow }}</div>{% endif %}
      <h1 class="title">{{ card.title }}</h1>

      {% if card.role == 'cover' and star_badge %}
        <div class="badge">⭐ {{ star_badge }}</div>
      {% endif %}

      {% if body_sentences %}
        <p class="body">{% for s in body_sentences %}<span class="s">{{ s }}</span>{% endfor %}</p>
      {% endif %}

      {% if card.code %}
        <div class="code">{% for line in card.code %}<div class="line">{{ line }}</div>{% endfor %}</div>
      {% endif %}

      {% if card.footnote %}<div class="footnote">{{ card.footnote }}</div>{% endif %}
    </div>

    <div class="footer">
      {# 커버는 제목이 곧 레포명이라 하단 태그가 중복된다 #}
      <span class="repo-tag">{{ '' if card.role == 'cover' else repo }}</span>
    </div>
  </div>
</div>
</body>
</html>
